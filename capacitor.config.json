{
  "appId": "com.xurface.discern.app",
  "appName": "Discern",
  "webDir": "www",
  "backgroundColor": "#000000",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 700,
      "backgroundColor": "#000000",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "launchAutoHide": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000"
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    }
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#000000"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#000000"
  }
}
